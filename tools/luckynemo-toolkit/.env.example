# 火山引擎方舟 API Key（必填，从方舟控制台获取）
ARK_API_KEY=

# 可选：覆盖默认 base URL（默认 https://ark.cn-beijing.volces.com）
# ARK_BASE_URL=https://ark.cn-beijing.volces.com
# 模型/端点覆盖（企业账号按端点 ID 调用时填）
# SEEDANCE_MODEL_DRAFT=ep-xxxx
# SEEDANCE_MODEL_FINAL=ep-xxxx
# SEEDREAM_MODEL=ep-xxxx

# MiniMax API Key（音乐/TTS/声音克隆走这条线；分镜脚本 LLM 也用它）
MINIMAX_API_KEY=
# 可选：覆盖默认 base URL（默认 https://api.minimaxi.com/v1）
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# MiniMax 大模型（分镜脚本生成用，默认 MiniMax-M3）
# MINIMAX_LLM_MODEL=MiniMax-M3
