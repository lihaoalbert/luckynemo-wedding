.page { padding: 24rpx; }
.empty { padding: 120rpx 0; text-align: center; }
.empty-txt { color: var(--ink-soft, #a89a90); font-size: 28rpx; }
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.cell {
  position: relative;
  width: calc((100% - 16rpx) / 2);
  border-radius: 12rpx; overflow: hidden; background: var(--blush, #f3e9e2);
}
.cell image { width: 100%; height: 460rpx; display: block; }
.cell-label {
  position: absolute; left: 12rpx; bottom: 12rpx;
  padding: 2rpx 14rpx; border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.45); color: #fff; font-size: 20rpx;
}
.tip { margin-top: 20rpx; font-size: 22rpx; color: var(--ink-soft, #a89a90); text-align: center; }
