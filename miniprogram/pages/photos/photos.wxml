<view class="page">
  <view class="empty" wx:if="{{!photos.length && !loading}}">
    <view class="empty-txt">还没有生成的照片，去创作页出一张吧～</view>
  </view>

  <view class="grid" wx:if="{{photos.length}}">
    <view class="cell" wx:for="{{photos}}" wx:key="key" data-url="{{item.url}}" bindtap="previewImg" bindlongpress="showOps" data-idx="{{index}}">
      <image src="{{item.url}}" mode="aspectFill" lazy-load />
      <view class="cell-label">{{item.label}}</view>
    </view>
  </view>
  <view class="tip" wx:if="{{photos.length}}">点开图可左右滑动 · 长按可保存/做分享海报/删除</view>

  <!-- 离屏 canvas：生成分享海报用 -->
  <canvas canvas-id="poster" style="position:fixed;left:-3000rpx;top:0;width:600px;height:900px;"></canvas>
</view>
