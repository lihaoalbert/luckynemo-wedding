<view class="page">
  <view class="hero">
    <view class="eyebrow">{{eyebrow}}</view>
    <view class="h1 serif">{{headline}}</view>
  </view>

  <!-- 整组九宫格结果 -->
  <block wx:if="{{photos.length}}">
    <view class="nine">
      <image wx:for="{{photos}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-url="{{item}}" data-key="{{photoKeys[index]}}" bindtap="previewOne" bindlongpress="reviseOne" />
    </view>
    <view class="row">
      <button class="btn ghost" bindtap="saveAll">全部存到相册</button>
      <button class="btn ghost">分享给朋友</button>
    </view>
    <view class="hint">长按某张可提意见重生成（每单免费 3 次）</view>

    <!-- 朋友圈 mock -->
    <view class="mm card">
      <view class="mm-title serif">发到朋友圈长这样</view>
      <view class="mm-main">
        <view class="mm-avatar serif">恩</view>
        <view class="mm-info">
          <view class="mm-name">徐大恩</view>
          <view class="mm-text">{{seriesTitle ? seriesTitle + '，' : ''}}一次出齐，刚刚好 🌸</view>
          <view class="mm-grid">
            <image wx:for="{{mmPhotos}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewOne" />
          </view>
          <view class="mm-foot">3分钟前 · LuckyNemo</view>
        </view>
      </view>
    </view>

    <!-- 模板 vs 成片 -->
    <view class="ba card" wx:if="{{templateCover}}">
      <view class="mm-title serif">模板 vs 你的成片</view>
      <view class="ba-row">
        <view class="ba-cell">
          <view class="lab">模板</view>
          <image src="{{templateCover}}" mode="aspectFill" />
        </view>
        <view class="ba-cell">
          <view class="lab">你的成片</view>
          <image src="{{photos[0]}}" mode="aspectFill" />
        </view>
      </view>
      <view class="mm-foot" style="margin-top: 12rpx;">场景 / 服装 / 构图还原模板，只换人</view>
    </view>
  </block>

  <block wx:else>
    <view class="photo card" bindtap="preview">
      <image wx:if="{{photo}}" src="{{photo}}" mode="widthFix" />
      <view wx:else class="ph">成片生成中，稍等一下下拉刷新～</view>
    </view>

    <view class="row">
      <button class="btn ghost" bindtap="save">存到相册</button>
      <button class="btn ghost">分享给朋友</button>
    </view>
    <button class="btn ghost revise-btn" bindtap="revise">不满意？提意见重生成</button>
  </block>

  <!-- 充值卡：免费+付费额度都用完才出现（反馈 #46） -->
  <view class="upcard card" wx:if="{{quotaLeft <= 0}}">
    <view class="uptitle serif">想要更多？</view>
    <view class="opt" bindtap="buyPer">
      <view><b>4 元/张</b><view class="sub">按张付费，喜欢再要</view></view>
      <view class="go">→</view>
    </view>
    <view class="opt hot" bindtap="buyPack">
      <view><b>52 元 · 20 张</b><view class="sub">多风格多场景，最划算</view></view>
      <view class="go">→</view>
    </view>
  </view>

  <view class="film card" bindtap="upgrade">
    <view class="uptitle serif">💌 还有更特别的</view>
    <view class="sub">把你们的故事做成一支爱情短片：专属脚本、配音配乐，婚礼开场放一次，纪念日再看一次。</view>
  </view>
</view>
