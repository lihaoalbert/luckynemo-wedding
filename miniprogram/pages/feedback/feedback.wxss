.page { min-height: 100vh; padding: 0 28rpx 60rpx; }
.hero { padding: 40rpx 0 20rpx; }
.sub { font-size: 24rpx; color: var(--ink-soft); margin-top: 8rpx; }
.type-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.type-item {
  padding: 14rpx 24rpx; border-radius: 999rpx; font-size: 26rpx;
  background: var(--surface); border: 1rpx solid var(--hairline);
}
.type-item.active { background: var(--accent); color: #fff; border-color: var(--accent); }
.ta {
  width: 100%; min-height: 200rpx; margin-top: 24rpx; padding: 24rpx;
  background: var(--surface); border: 1rpx solid var(--hairline);
  border-radius: 20rpx; font-size: 28rpx; box-sizing: border-box;
}
.imgs { display: flex; gap: 16rpx; margin-top: 24rpx; flex-wrap: wrap; }
.img-wrap { position: relative; width: 180rpx; height: 180rpx; }
.thumb { width: 180rpx; height: 180rpx; border-radius: 16rpx; background: var(--blush); }
.img-status {
  position: absolute; left: 0; right: 0; bottom: 0; font-size: 20rpx;
  background: rgba(43,35,32,0.55); color: #fff; text-align: center;
  border-radius: 0 0 16rpx 16rpx; padding: 4rpx 0;
}
.img-status.ok { background: rgba(63,125,78,0.75); }
.img-del {
  position: absolute; top: -12rpx; right: -12rpx; width: 40rpx; height: 40rpx;
  border-radius: 50%; background: rgba(43,35,32,0.7); color: #fff;
  display: flex; align-items: center; justify-content: center; font-size: 22rpx;
}
.img-add {
  width: 180rpx; height: 180rpx; border-radius: 16rpx;
  border: 2rpx dashed var(--hairline); color: var(--ink-soft);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  font-size: 48rpx;
}
.add-txt { font-size: 22rpx; margin-top: 6rpx; }
.submit { margin-top: 36rpx; }
.history { margin-top: 48rpx; }
.his-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.his-item {
  background: var(--surface); border: 1rpx solid var(--hairline);
  border-radius: 20rpx; padding: 20rpx 24rpx; margin-bottom: 16rpx;
}
.his-head { display: flex; justify-content: space-between; align-items: center; }
.his-type { font-size: 24rpx; color: var(--ink-soft); }
.his-status { font-size: 22rpx; color: var(--accent); }
.his-status.done { color: #3f7d4e; }
.his-text { font-size: 26rpx; margin-top: 10rpx; line-height: 1.6; }
.his-reply {
  margin-top: 10rpx; padding: 12rpx 16rpx; font-size: 24rpx; line-height: 1.6;
  background: #f4f9f5; color: #3f7d4e; border-radius: 12rpx;
}
.his-imgs { display: flex; gap: 12rpx; margin-top: 12rpx; }
.his-thumb { width: 120rpx; height: 120rpx; border-radius: 10rpx; }
.his-time { font-size: 20rpx; color: var(--ink-soft); margin-top: 10rpx; }
