.page { min-height: 100vh; padding: 0 28rpx 60rpx; }
.hero { padding: 40rpx 0 20rpx; }
.empty { padding: 120rpx 0; text-align: center; }
.empty-txt { color: var(--ink-soft); font-size: 26rpx; }
.card {
  background: var(--surface); border: 1rpx solid var(--hairline);
  border-radius: 24rpx; padding: 28rpx; margin-top: 24rpx;
}
.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.row { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 26rpx; }
.k { color: var(--ink-soft); }
.v { color: var(--ink); }
.order-no { margin-top: 12rpx; font-size: 22rpx; color: #b8aea6; }
.quota-row { display: flex; gap: 32rpx; align-items: baseline; }
.quota-num { font-size: 56rpx; font-weight: 700; color: var(--accent); }
.quota-unit { font-size: 24rpx; color: var(--ink-soft); font-weight: 400; margin-left: 8rpx; }
.quota-sub { font-size: 24rpx; color: var(--ink-soft); margin-top: 8rpx; }
.btn.mini {
  margin-top: 20rpx; font-size: 26rpx; padding: 14rpx 0;
}
.sec { margin-top: 16rpx; }
.sec-k { font-size: 24rpx; color: var(--ink-soft); margin-bottom: 12rpx; }
.sec-tip { font-size: 20rpx; color: #c8bcb4; margin-left: 12rpx; }
.imgs { display: flex; flex-wrap: wrap; gap: 12rpx; }
.imgs image { width: 150rpx; height: 200rpx; border-radius: 12rpx; background: var(--blush); }
.photo-item {
  display: flex; gap: 20rpx; align-items: center;
  padding: 16rpx 0; border-bottom: 1rpx dashed var(--hairline);
}
.photo-item:last-child { border-bottom: none; }
.photo-img { width: 140rpx; height: 186rpx; border-radius: 12rpx; background: var(--blush); flex: none; }
.photo-info { flex: 1; }
.photo-kind { font-size: 28rpx; font-weight: 600; }
.photo-time { font-size: 22rpx; color: var(--ink-soft); margin-top: 6rpx; }
.photo-ops { display: flex; gap: 16rpx; margin-top: 12rpx; }
.photo-save {
  display: inline-block; padding: 8rpx 24rpx;
  border-radius: 999rpx; border: 1rpx solid var(--accent);
  color: var(--accent); font-size: 24rpx;
}
.photo-del {
  display: inline-block; padding: 8rpx 24rpx;
  border-radius: 999rpx; border: 1rpx solid #d0c4bc;
  color: #a89a90; font-size: 24rpx;
}
.link-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18rpx 0; font-size: 28rpx; border-bottom: 1rpx dashed var(--hairline);
  background: transparent; line-height: 1.5;
}
.link-row:last-child { border-bottom: none; }
.share-link { border: none; text-align: left; width: 100%; }
.share-link::after { border: none; }
.arrow { color: var(--ink-soft); }
.img-wrap { position: relative; }
.img-wrap image { width: 150rpx; height: 200rpx; border-radius: 12rpx; background: var(--blush); }
.fs-mark {
  position: absolute; top: 6rpx; left: 6rpx;
  padding: 2rpx 12rpx; border-radius: 999rpx;
  background: var(--accent); color: #fff; font-size: 20rpx;
}
.btn.ghost { border: 1rpx solid #d0c4bc; color: #a89a90; background: transparent; }
