<view class="page">
  <view class="hero">
    <view class="eyebrow">LuckyNemo</view>
    <view class="h1 serif">我的</view>
  </view>

  <view class="empty" wx:if="{{!order.order_no && !loading}}">
    <view class="empty-txt">还没有订单，去创作页开始吧～</view>
  </view>

  <block wx:if="{{order.order_no}}">
    <!-- 额度 -->
    <view class="card">
      <view class="card-title serif">剩余额度</view>
      <view class="quota-row">
        <view class="quota-num">{{quotaTotal}}<text class="quota-unit">张可生成</text></view>
      </view>
      <view class="quota-sub">含免费 {{quota.free_left}} 张<block wx:if="{{quota.paid_left > 0}}"> · 已购 {{quota.paid_left}} 张</block></view>
      <button class="btn mini" bindtap="recharge">充值 / 续购 →</button>
    </view>

    <!-- 邀请有礼（裂变：好友首次出片，邀请人 +1 张免费额度） -->
    <button class="invite-banner" open-type="share">
      <view class="invite-title serif">邀请有礼</view>
      <view class="invite-sub">邀好友首次出片，你得 1 张免费额度 →</view>
    </button>

    <!-- 资产区 -->
    <view class="card">
      <view class="link-row" bindtap="goPhotos">相册（{{photos.length}} 张）<text class="arrow">→</text></view>
      <view class="link-row" bindtap="goFav">我的收藏<text class="arrow">→</text></view>
      <view class="link-row" bindtap="goUploads">我上传的照片（{{uploadsCount}} 张）<text class="arrow">→</text></view>
      <view class="privacy-note">照片仅用于为你生成作品，交付即删</view>
    </view>

    <!-- 人脸三视图（反馈 #26：治侧脸不像） -->
    <view class="card" wx:if="{{uploads.A.length || uploads.B.length}}">
      <view class="card-title serif">人脸三视图</view>
      <view class="quota-sub">用正脸底照 + 侧脸原照生成五官三视图，之后生成的照片里侧脸更像本人</view>
      <button class="btn mini" data-role="A" bindtap="fsStart">为我生成 →</button>
      <button class="btn mini" wx:if="{{uploads.B.length}}" data-role="B" bindtap="fsStart">为 TA 生成 →</button>
    </view>

    <!-- 个人信息（默认折叠） -->
    <view class="card">
      <view class="link-row" bindtap="toggleInfo">
        <text>个人信息 · {{order.mode === 'couple' ? '婚纱照（双人）' : order.mode === 'solo' ? '个人写真' : '未选择'}}</text>
        <text class="arrow">{{infoOpen ? '▲' : '▼'}}</text>
      </view>
      <block wx:if="{{infoOpen}}">
        <view class="order-no" bindlongpress="copyOrderNo">订单号 {{order.order_no}}（长按复制）</view>
      </block>
    </view>

    <!-- 帮助与其他 -->
    <view class="card">
      <view class="link-row" bindtap="goOrders">订单中心（充值记录）<text class="arrow">→</text></view>
      <view class="link-row" bindtap="goFeedback">意见反馈（bug / 功能期望）<text class="arrow">→</text></view>
      <button class="link-row share-link" open-type="contact">联系客服<text class="arrow">→</text></button>
      <view class="link-row" bindtap="privacy">隐私承诺（交付即删）<text class="arrow">→</text></view>
      <view class="link-row danger" bindtap="restart">开启新订单<text class="arrow">→</text></view>
    </view>
  </block>
</view>
