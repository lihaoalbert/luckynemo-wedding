/* AI 证件照拍摄页：相机全屏 + canvas 引导 overlay + 大字指引 */
.shoot { position: fixed; inset: 0; background: #1a1412; }

.cam { position: absolute; inset: 0; width: 100%; height: 100%; }
.guides { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }

/* 顶部信息条 */
.topbar {
  position: absolute; top: 24rpx; left: 24rpx; right: 24rpx;
  display: flex; justify-content: space-between; align-items: flex-start;
}
.chip {
  background: rgba(26, 20, 18, 0.55); color: #fff;
  font-size: 22rpx; padding: 10rpx 20rpx; border-radius: 999rpx;
}
.chip.model { color: #ffd9a0; }

/* 底部指引区：大字给摄影师看，台词卡照着喊 */
.coach {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 32rpx 32rpx 64rpx;
  background: linear-gradient(transparent, rgba(26, 20, 18, 0.82) 30%);
  display: flex; flex-direction: column; align-items: center;
}
.hint {
  font-size: 72rpx; font-weight: 700; color: #fff;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
}
.hint.ok { color: #7bd88f; }
.cue {
  margin-top: 28rpx; background: rgba(255, 253, 251, 0.95);
  border-radius: 28rpx; padding: 24rpx 32rpx; max-width: 620rpx;
}
.cue-tag { font-size: 20rpx; color: var(--gold); font-weight: 600; letter-spacing: 4rpx; }
.cue-text { font-size: 30rpx; color: var(--ink); margin-top: 6rpx; line-height: 1.6; }
.coach-btns { display: flex; gap: 24rpx; margin-top: 32rpx; }
.mini-btn {
  background: rgba(255, 253, 251, 0.2); color: #fff; border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 999rpx; font-size: 24rpx; padding: 12rpx 32rpx; line-height: 1.5;
}
.mini-btn.snap { background: var(--accent); border-color: var(--accent); font-size: 30rpx; padding: 16rpx 48rpx; }

/* 倒计时 */
.count-mask {
  position: absolute; inset: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.count-hint {
  font-size: 44rpx; color: #7bd88f; font-weight: 600;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.5);
}
.count-num {
  font-size: 300rpx; font-weight: 700; color: #fff; line-height: 1.2;
  text-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.5);
}

/* 非拍摄态面板（不透明盖住相机） */
.panel {
  position: absolute; inset: 0; background: var(--bg);
  padding: 80rpx 48rpx 64rpx;
  display: flex; flex-direction: column; align-items: center;
  overflow-y: auto; box-sizing: border-box;
}
.panel-title { font-size: 48rpx; font-weight: 600; margin-bottom: 32rpx; }
.panel-img {
  width: 520rpx; height: 640rpx; border-radius: 24rpx;
  background: var(--blush); border: 1rpx solid var(--hairline);
}
.panel-img.small { width: 360rpx; height: 440rpx; }
.panel-img.print { margin-top: 32rpx; }
.panel-tip { font-size: 24rpx; color: var(--ink-soft); margin-top: 24rpx; }
.btn-row { display: flex; gap: 32rpx; margin-top: 40rpx; }
.btn.wide { width: 560rpx; margin-top: 32rpx; box-sizing: border-box; }

/* 底色选择 */
.bg-row { display: flex; gap: 32rpx; margin-top: 40rpx; }
.bg-block {
  width: 160rpx; height: 160rpx; border-radius: 24rpx;
  border: 4rpx solid transparent;
  display: flex; align-items: flex-end; justify-content: center;
  padding-bottom: 16rpx; box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx -12rpx rgba(59, 44, 40, 0.4);
}
.bg-block.on { border-color: var(--ink); }
.bg-name {
  font-size: 22rpx; color: #fff; background: rgba(26, 20, 18, 0.55);
  padding: 2rpx 16rpx; border-radius: 999rpx;
}

/* 付费墙 */
.pay-desc {
  font-size: 28rpx; color: var(--ink-soft); line-height: 1.8;
  max-width: 560rpx; text-align: center;
}

/* 冲印中动画 */
.wash { display: flex; gap: 24rpx; margin: 80rpx 0; }
.wash-dot {
  width: 28rpx; height: 28rpx; border-radius: 50%;
  background: var(--accent);
  animation: wash-bounce 1.2s infinite ease-in-out;
}
.wash-dot.d2 { animation-delay: 0.2s; background: var(--gold); }
.wash-dot.d3 { animation-delay: 0.4s; }
@keyframes wash-bounce {
  0%, 100% { transform: translateY(0); opacity: 0.5; }
  50% { transform: translateY(-28rpx); opacity: 1; }
}

/* 导流卡 */
.moka-card {
  margin-top: 48rpx; width: 560rpx; box-sizing: border-box;
  background: linear-gradient(135deg, var(--accent), var(--gold));
  border-radius: 28rpx; padding: 36rpx 40rpx;
}
.moka-title { font-size: 38rpx; color: #fff; font-weight: 600; }
.moka-sub { font-size: 24rpx; color: rgba(255, 255, 255, 0.85); margin-top: 8rpx; }
