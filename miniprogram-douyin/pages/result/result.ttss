.page { min-height: 100vh; padding: 0 28rpx 60rpx; }
.hero { padding: 40rpx 0 20rpx; }
.photo { padding: 0; overflow: hidden; }
.photo image { width: 100%; display: block; }
.ph { padding: 120rpx 40rpx; text-align: center; color: var(--ink-soft); font-size: 26rpx; }
.row { display: flex; gap: 20rpx; margin-top: 28rpx; }
.row .btn { flex: 1; }
.upcard { margin-top: 32rpx; }
.uptitle { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }
.opt {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 0; border-top: 1rpx solid var(--hairline); font-size: 28rpx;
}
.opt.hot b { color: var(--accent); }
.go { color: var(--accent); font-weight: 700; }
.film { margin-top: 28rpx; background: linear-gradient(135deg, rgba(201, 145, 63, 0.12), transparent 60%); border-color: rgba(201, 145, 63, 0.4); }
/* 整组九宫格结果 */
.nine {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 8rpx;
  border-radius: 16rpx; overflow: hidden;
}
.nine image { width: 100%; aspect-ratio: 1; background: var(--blush); display: block; }
/* 朋友圈 mock */
.mm { margin-top: 32rpx; }
.mm-title { font-size: 28rpx; font-weight: 600; }
.mm-main { display: flex; gap: 20rpx; margin-top: 20rpx; }
.mm-avatar {
  flex: none; width: 72rpx; height: 72rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, #d9b98c, var(--gold));
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 28rpx;
}
.mm-info { flex: 1; min-width: 0; }
.mm-name { font-size: 26rpx; font-weight: 700; color: #576b95; }
.mm-text { font-size: 22rpx; color: var(--ink-soft); margin-top: 4rpx; }
.mm-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6rpx; margin-top: 16rpx; }
.mm-grid image { width: 100%; aspect-ratio: 1; background: var(--blush); display: block; }
.mm-foot { font-size: 20rpx; color: #a89a90; margin-top: 12rpx; }
/* 模板 vs 成片 */
.ba { margin-top: 28rpx; }
.ba-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.ba-cell { flex: 1; border-radius: 20rpx; overflow: hidden; position: relative; }
.ba-cell image { width: 100%; aspect-ratio: 3/4; background: var(--blush); display: block; }
.ba-cell .lab {
  position: absolute; left: 12rpx; top: 12rpx; z-index: 2;
  font-size: 18rpx; color: #fff; background: rgba(0, 0, 0, 0.5);
  border-radius: 999rpx; padding: 4rpx 16rpx;
}
