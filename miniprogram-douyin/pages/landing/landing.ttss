.page { min-height: 100vh; position: relative; background: var(--bg, #fdf8f4); }
.swiper { height: 100vh; }
.screen { padding: 120rpx 48rpx 0; }
.skip {
  position: absolute; top: 60rpx; right: 40rpx; z-index: 10;
  padding: 8rpx 28rpx; border-radius: 999rpx;
  border: 1rpx solid var(--hairline, #e5d9d0); color: #a89a90; font-size: 24rpx;
}
.eyebrow { font-size: 24rpx; letter-spacing: 4rpx; color: #a89a90; margin-bottom: 16rpx; }
.h1 { font-size: 52rpx; font-weight: 700; line-height: 1.3; margin-bottom: 40rpx; }
.accent { color: var(--accent, #c0736a); }
.showcase { display: flex; gap: 16rpx; }
.showcase image { width: calc((100% - 32rpx) / 3); height: 440rpx; border-radius: 20rpx; }
.sub { margin-top: 32rpx; font-size: 28rpx; color: #a89a90; }
.steps { display: flex; flex-direction: column; gap: 40rpx; margin-top: 20rpx; }
.step { display: flex; gap: 24rpx; align-items: flex-start; }
.num {
  width: 64rpx; height: 64rpx; border-radius: 50%; flex: none;
  background: var(--accent, #c0736a); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700;
}
.step-k { font-size: 32rpx; font-weight: 600; }
.step-d { font-size: 26rpx; color: #a89a90; margin-top: 6rpx; }
.privacy { margin: 20rpx 0 60rpx; }
.privacy .li { font-size: 28rpx; margin-top: 28rpx; line-height: 1.6; }
.cta {
  background: var(--accent, #c0736a); color: #fff; border-radius: 999rpx;
  font-size: 32rpx; font-weight: 600; padding: 24rpx 0;
}
.dots {
  position: absolute; bottom: 60rpx; left: 0; right: 0;
  display: flex; justify-content: center; gap: 12rpx;
}
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #e0d3ca; }
.dot.on { background: var(--accent, #c0736a); }
